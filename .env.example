# ─── Shared ───────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate with: openssl rand -base64 32"
DEMO_LOGIN="true"            # one-click demo students on the login page; set "false" for public use
CACHE_MODE="readwrite"       # off | read | readwrite — answers are cached per model, checked before any API call
AI_TIMEOUT_MS="600000"

# ─── Profile 1: LOCAL / OFFLINE (Ollama on this machine) ─────────────
AI_PROVIDERS="ollama"
AI_BASE_URL="http://localhost:11434"
MODEL_FAST="qwen3.5:4b"
MODEL_SMART="qwen3.5:4b"
AI_NUM_CTX="8192"
AI_CONCURRENCY="1"

# ─── Profile 2: ONLINE JUDGING (no GPU; open-weight models via API) ───
# Comment out profile 1's AI_PROVIDERS and use this instead. Tried in order; then a clear error.
# AI_PROVIDERS="groq,gemini"
# Groq — https://console.groq.com/keys
# GROQ_API_KEY=""
# GROQ_MODEL_FAST="openai/gpt-oss-20b"
# GROQ_MODEL_SMART="openai/gpt-oss-120b"
# GROQ_RPM="30"              # requests/minute budget; requests are spaced to stay under it
# Gemma via the Gemini API — https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# GEMINI_MODEL_FAST="gemma-3-12b-it"
# GEMINI_MODEL_SMART="gemma-3-27b-it"
# GEMINI_RPM="15"

# Optional Google sign-in (not needed for the demo)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
