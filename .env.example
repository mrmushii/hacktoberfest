# ─── Shared ───────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate with: openssl rand -base64 32"
DEMO_LOGIN="true"            # one-click demo students on the login page; set "false" for public use
CACHE_MODE="readwrite"       # off | read | readwrite — answers are cached per model, checked before any API call
AI_TIMEOUT_MS="600000"

# ─── Profile 1: LOCAL / OFFLINE (Ollama on this machine) ─────────────
AI_PROVIDERS="ollama"
AI_BASE_URL="http://localhost:11434"
MODEL_FAST="qwen3.5:4b"
MODEL_SMART="qwen3.5:4b"
AI_NUM_CTX="8192"
AI_CONCURRENCY="1"

# ─── Profile 2: ONLINE JUDGING (no GPU; open-weight models via API) ───
# Comment out profile 1's AI_PROVIDERS and use this instead. Tried in order; then a clear error.
# Order = fallback order. Any subset works; providers without a key are skipped.
# AI_PROVIDERS="groq,cerebras,openrouter,huggingface,gemini"
# OpenRouter — https://openrouter.ai/keys  (":free" models are free but tightly rate-limited)
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL_FAST="google/gemma-4-26b-a4b-it:free"
# OPENROUTER_MODEL_SMART="google/gemma-4-31b-it:free"
# OPENROUTER_RPM="20"
# Hugging Face Inference Providers — https://huggingface.co/settings/tokens (token with "Inference Providers" permission)
# HF_TOKEN=""
# HF_MODEL_FAST="openai/gpt-oss-20b"
# HF_MODEL_SMART="Qwen/Qwen3-235B-A22B-Instruct-2507"
# HF_RPM="30"
# Cerebras — https://cloud.cerebras.ai
# CEREBRAS_API_KEY=""
# CEREBRAS_MODEL_FAST="qwen-3.8-27b"
# CEREBRAS_MODEL_SMART="gpt-oss-120b"
# CEREBRAS_RPM="30"
# Groq — https://console.groq.com/keys
# GROQ_API_KEY=""
# GROQ_MODEL_FAST="openai/gpt-oss-20b"
# GROQ_MODEL_SMART="openai/gpt-oss-120b"
# GROQ_RPM="30"              # requests/minute budget; requests are spaced to stay under it
# Gemma via the Gemini API — https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# GEMINI_MODEL_FAST="gemma-4-26b-a4b-it"
# GEMINI_MODEL_SMART="gemma-4-31b-it"
# GEMINI_RPM="15"

# Optional Google sign-in (not needed for the demo)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
